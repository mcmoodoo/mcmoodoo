set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Image to build and run on the pod
GHCR_USER := "mcmoodoo"
IMAGE := env_var_or_default("IMAGE", "ghcr.io/mcmoodoo/runpod-vllm")
TAG := env_var_or_default("TAG", "latest")

# GPU pod: set POD_ID after creating; set POD_URL (e.g. https://xxx.runpod.net) for vllm-chat
POD_ID := env_var_or_default("POD_ID", "")
POD_URL := env_var_or_default("POD_URL", "")
GPU_TYPE := env_var_or_default("GPU_TYPE", "NVIDIA GeForce RTX 4090")

default:
  @just --list

ghcr-login:
  @test -n "${RUNPOD_GHCR_TOKEN:-}" || (echo "RUNPOD_GHCR_TOKEN is not set" && exit 1)
  echo "$RUNPOD_GHCR_TOKEN" | docker login ghcr.io -u {{GHCR_USER}} --password-stdin

docker-build:
  docker build -t {{IMAGE}}:{{TAG}} .

docker-push: ghcr-login docker-build
  docker push {{IMAGE}}:{{TAG}}

# --- runpodctl (set RUNPOD_API_KEY; for private image also RUNPOD_GHCR_TOKEN) ---

runpod-config:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  runpodctl config --apiKey="$RUNPOD_API_KEY"

runpod-registry:
  @test -n "${RUNPOD_GHCR_TOKEN:-}" || (echo "RUNPOD_GHCR_TOKEN is not set" && exit 1)
  runpodctl registry create \
    --name ghcr-mcmoodoo \
    --username {{GHCR_USER}} \
    --password "$RUNPOD_GHCR_TOKEN"

# Create a GPU pod running the vLLM image. Optional: HF_TOKEN. Exposes port 8000.
runpod-pod-create:
  runpodctl create pod \
    --name vllm-pod \
    --imageName {{IMAGE}}:{{TAG}} \
    --gpuType "{{GPU_TYPE}}" \
    --gpuCount 1 \
    --containerDiskSize 30 \
    --volumeSize 50 \
    --volumeMountPath /workspace \
    --ports 8000/http \
    --env "MODEL_DIR=/workspace" \
    --env "MODEL_ID=OpenHands/openhands-lm-7b-v0.1" \
    $(if [ -n "${HF_TOKEN:-}" ]; then echo --env "HF_TOKEN=$HF_TOKEN"; fi)

runpod-pod-list:
  runpodctl pod list --output=table

runpod-pod-get:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod get {{POD_ID}}

runpod-pod-start:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod start {{POD_ID}}

runpod-pod-stop:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod stop {{POD_ID}}

runpod-pod-delete:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod delete {{POD_ID}}

# Call vLLM chat completions on the pod. Set POD_URL (e.g. https://xxx.runpod.net or http://pod-ip:8000).
vllm-chat:
  @test -n "{{POD_URL}}" || (echo "POD_URL is not set" && exit 1)
  base="$$(echo {{POD_URL}} | sed 's|/*$$||')"
  jq -n --arg msg "${MESSAGE:-Hello, what model are you?}" \
    '{model: "openhands-lm-7b-v0.1", messages: [{role: "user", content: $msg}], max_tokens: 256}' \
    | curl -sS -X POST "$$base/v1/chat/completions" -H "Content-Type: application/json" -d @-
