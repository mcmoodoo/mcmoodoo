set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Image to build and run on the pod
GHCR_USER := "mcmoodoo"
IMAGE := env_var_or_default("IMAGE", "ghcr.io/mcmoodoo/runpod-vllm")
TAG := env_var_or_default("TAG", "latest")

# GPU pod: set POD_ID after creating; set POD_URL (e.g. https://xxx.runpod.net) for vllm-chat
POD_ID := env_var_or_default("POD_ID", "")
POD_URL := env_var_or_default("POD_URL", "")

default:
  @just --list

ghcr-login:
  @test -n "${RUNPOD_GHCR_TOKEN:-}" || (echo "RUNPOD_GHCR_TOKEN is not set" && exit 1)
  echo "$RUNPOD_GHCR_TOKEN" | docker login ghcr.io -u {{GHCR_USER}} --password-stdin

docker-build:
  docker build -t {{IMAGE}}:{{TAG}} .

docker-push: ghcr-login docker-build
  docker push {{IMAGE}}:{{TAG}}

# --- runpodctl (set RUNPOD_API_KEY; for private image also RUNPOD_GHCR_TOKEN) ---

runpod-config:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  runpodctl config --apiKey="$RUNPOD_API_KEY"

runpod-registry:
  @test -n "${RUNPOD_GHCR_TOKEN:-}" || (echo "RUNPOD_GHCR_TOKEN is not set" && exit 1)
  runpodctl registry create \
    --name ghcr-mcmoodoo \
    --username {{GHCR_USER}} \
    --password "$RUNPOD_GHCR_TOKEN"

# Create a GPU pod running the vLLM image. Exposes port 8000 and 22.
# All defaults: runpod-pod-profile.json (container_env + runpod). Override path with POD_PROFILE_JSON.
# HF_TOKEN merged into container env from the shell when set. GPU_TYPE overrides runpod.gpu_id.
# GPU_COUNT overrides runpod.gpu_count (Runpod --gpu-count; default 1 in profile).
runpod-pod-create:
  hf="${HF_TOKEN:-${HUGGING_FACE_HUB_TOKEN:-}}" ; \
  profile="${POD_PROFILE_JSON:-{{justfile_directory()}}/runpod-pod-profile.json}" ; \
  test -f "$profile" || (echo "missing pod profile: $profile" >&2 && exit 1) ; \
  env_json="$(jq -c --arg HF_TOKEN "$hf" \
    'if ($HF_TOKEN|length) > 0 then .container_env + {HF_TOKEN: $HF_TOKEN} else .container_env end' \
    "$profile")" ; \
  pod_name="$(jq -r '.runpod.name' "$profile")" ; \
  gpu_id="$(jq -r '.runpod.gpu_id' "$profile")" ; \
  if [ -n "${GPU_TYPE:-}" ]; then gpu_id="$GPU_TYPE" ; fi ; \
  gpu_count="$(jq -r '.runpod.gpu_count // 1' "$profile")" ; \
  if [ -n "${GPU_COUNT:-}" ]; then gpu_count="$GPU_COUNT" ; fi ; \
  disk_gb="$(jq -r '.runpod.container_disk_in_gb' "$profile")" ; \
  vol_gb="$(jq -r '.runpod.volume_in_gb' "$profile")" ; \
  ports="$(jq -r '.runpod.ports' "$profile")" ; \
  runpodctl pod create \
    --name "$pod_name" \
    --image {{IMAGE}}:{{TAG}} \
    --gpu-id "$gpu_id" \
    --gpu-count "$gpu_count" \
    --container-disk-in-gb "$disk_gb" \
    --volume-in-gb "$vol_gb" \
    --ports "$ports" \
    --env "$env_json"

runpod-pod-list:
  runpodctl pod list --output=table

runpod-pod-get:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod get {{POD_ID}}

runpod-pod-start:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod start {{POD_ID}}

runpod-pod-stop:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod stop {{POD_ID}}

runpod-pod-delete:
  @test -n "{{POD_ID}}" || (echo "POD_ID is not set" && exit 1)
  runpodctl pod delete {{POD_ID}}

# Call vLLM chat completions on the pod. Set POD_URL (e.g. https://xxx.runpod.net or http://pod-ip:8000).
vllm-chat msg:
  @test -n "${POD_URL:-}" || (echo "POD_URL is not set" && exit 1) ; \
  jq -n --arg msg "{{msg}}" \
    '{model: "openhands-lm-7b-v0.1", messages: [{role: "user", content: $msg}], max_tokens: 256}' \
    | curl -sS -X POST "${POD_URL%/}/v1/chat/completions" -H "Content-Type: application/json" -d @-

secretsmanager-create-secrets:
    aws secretsmanager create-secret \
      --name "runpod/GHCR_TOKEN" \
      --secret-string "$RUNPOD_GHCR_TOKEN" \
      --region "us-east-1" \
    || aws secretsmanager put-secret-value \
      --secret-id "runpod/GHCR_TOKEN" \
      --secret-string "$RUNPOD_GHCR_TOKEN" \
      --region "us-east-1"
    aws secretsmanager create-secret \
      --name "runpod/API_KEY" \
      --secret-string "$RUNPOD_API_KEY" \
      --region "us-east-1" \
    || aws secretsmanager put-secret-value \
      --secret-id "runpod/API_KEY" \
      --secret-string "$RUNPOD_API_KEY" \
      --region "us-east-1"
    aws secretsmanager create-secret \
      --name "runpod/HF_TOKEN" \
      --secret-string "$HF_TOKEN" \
      --region "us-east-1" \
    || aws secretsmanager put-secret-value \
      --secret-id "runpod/HF_TOKEN" \
      --secret-string "$HF_TOKEN" \
      --region "us-east-1"

secretsmanager-get-secrets:
    @echo "RUNPOD_GHCR_TOKEN:"
    aws secretsmanager get-secret-value \
      --secret-id "runpod/GHCR_TOKEN" \
      --query "SecretString" \
      --output text \
      --region "us-east-1"
    @echo "RUNPOD_API_KEY:"
    aws secretsmanager get-secret-value \
      --secret-id "runpod/API_KEY" \
      --query "SecretString" \
      --output text \
      --region "us-east-1"
    @echo "HF_TOKEN:"
    aws secretsmanager get-secret-value \
      --secret-id "runpod/HF_TOKEN" \
      --query "SecretString" \
      --output text \
      --region "us-east-1"

secretsmanager-export-env:
    echo "export RUNPOD_GHCR_TOKEN=$(aws secretsmanager get-secret-value \
      --secret-id "runpod/GHCR_TOKEN" \
      --query "SecretString" \
      --output text \
      --region "us-east-1")"
    echo "export RUNPOD_API_KEY=$(aws secretsmanager get-secret-value \
      --secret-id "runpod/API_KEY" \
      --query "SecretString" \
      --output text \
      --region "us-east-1")"
    echo "export HF_TOKEN=$(aws secretsmanager get-secret-value \
      --secret-id "runpod/HF_TOKEN" \
      --query "SecretString" \
      --output text \
      --region "us-east-1")"

# List US datacenters with available GPUs; optionally filter by GPU id.
datacenters gpu_id="":
  runpodctl datacenter list | jq --arg gpu_id "{{gpu_id}}" 'def matches_gpu($gid): ($gid|length)==0 or ((.gpuAvailability // []) | any(((.gpuId? // .gpuTypeId? // .id? // "") | tostring) == $gid)); .[] | select(.location == "United States" and ((.gpuAvailability // []) | any(.stockStatus == "High" or .stockStatus == "Medium")) and matches_gpu($gpu_id))'
