set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

GHCR_USER := "mcmoodoo"
IMAGE := env_var_or_default("IMAGE", "ghcr.io/mcmoodoo/runpod-llama-chat")
TAG := env_var_or_default("TAG", "latest")
S3_BUCKET := env_var_or_default("S3_BUCKET", "mcmoodoo")

# Single source of truth for your LLM endpoint.
# Override ENDPOINT_ID in the environment if you deploy a new one.
ENDPOINT_ID := env_var_or_default("ENDPOINT_ID", "wytwfuoblqrm57")

# RunPod serverless: pass TEMPLATE_ID, GPU_ID, DATACENTER_ID, HF_TOKEN, RUNPOD_API_KEY as needed
# For private GHCR image: run `just runpod-registry` then `just runpod-registry-list` and set REGISTRY_AUTH_ID
TEMPLATE_ID := env_var_or_default("TEMPLATE_ID", "")
REGISTRY_AUTH_ID := env_var_or_default("REGISTRY_AUTH_ID", "")
GPU_ID := env_var_or_default("GPU_ID", "NVIDIA A40")
DATACENTER_ID := env_var_or_default("DATACENTER_ID", "CA-MTL-1")

default:
  @just --list

ghcr-login:
  @test -n "${RUNPOD_GHCR_TOKEN:-}" || (echo "RUNPOD_GHCR_TOKEN is not set" && exit 1)
  echo "$RUNPOD_GHCR_TOKEN" | docker login ghcr.io -u {{GHCR_USER}} --password-stdin

docker-build:
  docker build -t {{IMAGE}}:{{TAG}} .

docker-push: ghcr-login docker-build
  docker push {{IMAGE}}:{{TAG}}

# --- runpodctl (set RUNPOD_API_KEY; for private image also RUNPOD_GHCR_TOKEN) ---

runpod-config:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  runpodctl config --apiKey="$RUNPOD_API_KEY"

runpod-registry:
  @test -n "${RUNPOD_GHCR_TOKEN:-}" || (echo "RUNPOD_GHCR_TOKEN is not set" && exit 1)
  runpodctl registry create \
    --name ghcr-mcmoodoo \
    --username {{GHCR_USER}} \
    --password "$RUNPOD_GHCR_TOKEN"

runpod-registry-list:
  runpodctl registry list --output=table

runpod-datacenters:
  runpodctl datacenter list --output=table

runpod-gpus:
  runpodctl gpu list --output=table

runpod-template-list:
  runpodctl template list --type user --output=table

runpod-template-create:
  @test -n "${HF_TOKEN:-}" || (echo "HF_TOKEN is not set" && exit 1)
  # For private image (GHCR): set REGISTRY_AUTH_ID to the id from `just runpod-registry-list` after `just runpod-registry`
  runpodctl template create \
    --name runpod-llama-chat \
    --image {{IMAGE}}:{{TAG}} \
    --serverless \
    --docker-entrypoint "/app/start.sh" \
    --container-disk-in-gb 30 \
    --volume-mount-path /runpod-volume \
    $(if [ -n "{{REGISTRY_AUTH_ID}}" ]; then echo --container-registry-auth-id "{{REGISTRY_AUTH_ID}}"; fi) \
    --env '{"HF_TOKEN":"'$HF_TOKEN'","MODEL_DIR":"/runpod-volume/model","MODEL_ID":"meta-llama/Llama-3.2-3B-Instruct"}'

runpod-endpoint TEMPLATE_ID:
  @test -n "{{TEMPLATE_ID}}" || (echo "TEMPLATE_ID is required (from runpod-template-list)" && exit 1)
  @test -n "{{GPU_ID}}" || (echo "GPU_ID is not set (from runpod-gpus)" && exit 1)
  @test -n "{{DATACENTER_ID}}" || (echo "DATACENTER_ID is not set (from runpod-datacenters)" && exit 1)
  runpodctl serverless create \
    --name llama-chat-endpoint \
    --template-id {{TEMPLATE_ID}} \
    --gpu-id "{{GPU_ID}}" \
    --data-center-ids {{DATACENTER_ID}} \
    --workers-min 0 \
    --workers-max 3 \
    --gpu-count 1

runpod-list:
  runpodctl serverless list --output=table

runpod-endpoint-delete:
  @test -n "{{ENDPOINT_ID}}" || (echo "ENDPOINT_ID is not set" && exit 1)
  runpodctl serverless delete {{ENDPOINT_ID}}

runpod-get:
  @test -n "{{ENDPOINT_ID}}" || (echo "ENDPOINT_ID is not set" && exit 1)
  runpodctl serverless get {{ENDPOINT_ID}}

s3-upload local_path s3_key:
  @test -f "{{local_path}}" || (echo "File '{{local_path}}' not found" && exit 1)
  aws s3 cp "{{local_path}}" "s3://{{S3_BUCKET}}/{{s3_key}}"

s3-url s3_key:
  @test -n "{{s3_key}}" || (echo "s3_key is required" && exit 1)
  echo "https://{{S3_BUCKET}}.s3.amazonaws.com/{{s3_key}}"

llm-health id="wytwfuoblqrm57":
  curl -X GET https://api.runpod.ai/v2/{{id}}/health \
    -H 'accept: application/json' \
    -H 'Authorization: Bearer YOUR_API_KEY'

llm-sample-call:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  @test -n "{{ENDPOINT_ID}}" || (echo "ENDPOINT_ID is not set" && exit 1)
  # Async call to your own endpoint using {input: {message}}.
  # Returns a job id; poll with `just llm-sample-status <job_id>`.
  jq -n --arg msg "${MESSAGE:-Tighten up this text about life decisions.}" '{input: {message: $msg}}' \
    | curl -X POST "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/run" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $RUNPOD_API_KEY" \
      -d @-

llm-sample-status job_id:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  @test -n "{{ENDPOINT_ID}}" || (echo "ENDPOINT_ID is not set" && exit 1)
  curl -X GET "https://api.runpod.ai/v2/{{ENDPOINT_ID}}/status/{{job_id}}" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $RUNPOD_API_KEY"

tts-sample-call:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  curl -X POST https://api.runpod.ai/v2/chatterbox-turbo/runsync \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $RUNPOD_API_KEY" \
    -d '{"input":{"prompt":"Sorry, I misspoke earlier—Git reflogs are purely local. Once a commit leaves your machine, the remote may still retain the old commit even if you rewrite history. Dangling commits aren’t visible in the normal branch graph, but secret-scanning bots are extremely fast and can pick up leaked data in seconds. Bottom line: if a secret ever left your machine in raw form, assume it’s leaked. Revoke tokens, deactivate API keys, and if it’s a private key for a non-custodial wallet—withdraw funds immediately and hope no bot got there first.\n","voice":"gordon","format":"wav"}}'

tts-sample-status job_id:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  curl -X GET "https://api.runpod.ai/v2/chatterbox-turbo/status/{{job_id}}" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $RUNPOD_API_KEY"

asr-sample-call audio_url:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  @test -n "{{audio_url}}" || (echo "audio_url is required" && exit 1)
  curl -X POST https://api.runpod.ai/v2/whisper-v3-large/runsync \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $RUNPOD_API_KEY" \
    -d '{"input":{"prompt":"","audio":"{{audio_url}}"}}'

asr-sample-status job_id:
  @test -n "${RUNPOD_API_KEY:-}" || (echo "RUNPOD_API_KEY is not set" && exit 1)
  curl -X GET "https://api.runpod.ai/v2/whisper-v3-large/status/{{job_id}}" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer $RUNPOD_API_KEY"
